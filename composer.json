{
  "$schema": "https://getcomposer.org/schema.json",
  "name": "ilyakabanov/mago-yii2-extension",
  "description": "Yii2 framework support for the Mago PHP static analyzer.",
  "type": "library",
  "license": "MIT",
  "keywords": [
    "mago",
    "yii2",
    "static-analysis"
  ],
  "require": {
    "php": "^8.1",
    "carthage-software/mago": "^1.47.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.5 || ^12.0"
  },
  "autoload": {
    "psr-4": {
      "Ilyakabanov\\MagoYii2\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Ilyakabanov\\MagoYii2\\Tests\\": "tests/Unit/"
    }
  },
  "config": {
    "allow-plugins": false,
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
